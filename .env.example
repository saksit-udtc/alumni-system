# ---- Postgres ----
POSTGRES_USER=alumni
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=alumni_homecoming

# ---- App / JWT ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
APP_BASE_URL=http://localhost:3000

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
# Public URL used to build public floor-plan image links shown to guests.
# On-prem behind Cloudflare Tunnel, point this at the tunnel hostname for
# a separate minio subdomain, or proxy /minio-public/* through the app.
MINIO_PUBLIC_URL=http://localhost:9000

# ---- SMTP (generic, works with any provider: school mail server, Gmail
#      app password, self-hosted Postfix, etc. — no SaaS-specific API) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@alumni-homecoming.local

# ---- Cron ----
CRON_SCHEDULE=*/5 * * * *

# ---- One-time admin seed (used by `npm run prisma:seed` inside app/) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_after_first_login

# ---- app/.env.local (Next.js dev only — same DATABASE_URL etc. as above,
#      pointed at localhost instead of the docker service names) ----
# DATABASE_URL=postgresql://alumni:change_me_strong_password@localhost:5432/alumni_homecoming
