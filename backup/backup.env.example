# =============================================================================
# backup.env.example — ตัวอย่างไฟล์ตั้งค่าของ backup.sh / restore.sh
#
# วิธีใช้:  cp backup/backup.env.example backup/backup.env
#           chmod 600 backup/backup.env
#           แล้วแก้ค่าที่จำเป็น (ค่าที่ไม่ระบุจะใช้ค่าเริ่มต้นตามที่เขียนไว้ที่นี่)
#
# หมายเหตุ: ไฟล์นี้ถูก source โดย bash — ค่าที่มีช่องว่างต้องใส่เครื่องหมายคำพูด
# รหัสผ่านฐานข้อมูล/MinIO ไม่ต้องใส่ที่นี่ สคริปต์อ่านจาก .env ของ docker compose เอง
# =============================================================================

# ---------- ตำแหน่งโปรเจกต์ (โฟลเดอร์ที่มี docker-compose.yml และ .env) ----------
# ค่าเริ่มต้น = โฟลเดอร์แม่ของ backup/  (บนเซิร์ฟเวอร์คือ /opt/alumni-system)
#COMPOSE_DIR=/opt/alumni-system

# ---------- ที่เก็บสำเนาในเครื่องนี้ (dump ฐานข้อมูล, log) ----------
BACKUP_DIR=/opt/backups/alumni

# ---------- ปลายทาง: ชื่อ remote ของ rclone ----------
# ต้องเป็น remote ชนิด crypt ที่ครอบปลายทางจริงอยู่ (สคริปต์จะไม่ส่งข้อมูลออกถ้าไม่ได้เข้ารหัส)
#   - Synology NAS (SFTP):  ชื่อ nas-crypt      ดู backup/NAS.md
#   - Google Drive:         ชื่อ gdrive-crypt   ดู backup/README.md ข้อ 2-3
RCLONE_REMOTE=nas-crypt
# โฟลเดอร์ย่อยภายใน remote (ชื่อจะถูกเข้ารหัสบนปลายทางด้วย)
REMOTE_PATH=alumni

# ถ้า cron/ผู้ใช้อื่นต้องอ่าน rclone.conf จากที่อื่น ให้ระบุ path ตรงนี้
#RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# ---------- ระยะเวลาเก็บสำรอง ----------
KEEP_LOCAL_DAYS=7        # สำเนา dump ในเครื่องนี้ (เก็บอย่างน้อย 3 ไฟล์ล่าสุดเสมอ)
KEEP_REMOTE_DAYS=30      # สำเนารายวันบนปลายทาง และที่พักไฟล์ MinIO ที่ถูกลบ/ทับ
KEEP_REMOTE_MIN=7        # แม้เก่ากว่าที่กำหนด จะเก็บ dump รายวันล่าสุดอย่างน้อยกี่ไฟล์ (กันสำรองหยุดแล้วลบจนหมด)
KEEP_MONTHLY=6           # สำเนารายเดือน (1 ไฟล์/เดือน) เก็บกี่เดือนล่าสุด

# ---------- MinIO ----------
# พอร์ตที่ docker-compose เปิดให้เครื่อง host ("127.0.0.1:9002:9000" ในไฟล์ปัจจุบัน)
MINIO_ENDPOINT=http://127.0.0.1:9002
# ปล่อยว่าง = สำรองทุก bucket   หรือระบุเช่น "payment-slips merch-products"
MINIO_BUCKETS=

# ---------- ตรวจสอบก่อนเริ่ม ----------
MIN_FREE_MB=500          # ถ้าพื้นที่ว่างในเครื่องน้อยกว่านี้ จะไม่เริ่มสำรอง

# ---------- แจ้งเตือนเมื่อสำรองล้มเหลว/ไม่ทำงาน (ไม่บังคับ) ----------
# ใช้ https://healthchecks.io (หรือติดตั้งเองในวิทยาลัย): สร้าง check แล้ววาง ping URL ที่นี่
# สคริปต์จะส่ง /start, สำเร็จ, และ /fail (พร้อมท้าย log) ให้ — ถ้าเงียบเกินเวลาที่ตั้ง จะแจ้งเตือนทางอีเมล/แชตให้เอง
#HC_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------- ขั้นสูง ----------
# แฟลกที่ส่งให้ rclone ทุกคำสั่ง (ถ้าใช้ Google Drive มีข้อจำกัดอัตราเรียก API จึงไม่ควรตั้ง transfers สูงเกินไป)
#RCLONE_FLAGS="--transfers=4 --checkers=8 --retries=5 --low-level-retries=10 --stats=0"
# อนุญาตให้ส่งขึ้น remote ที่ไม่เข้ารหัส (ไม่แนะนำ — มีข้อมูลส่วนบุคคลและสลิปโอนเงิน)
#ALLOW_PLAINTEXT_REMOTE=false
