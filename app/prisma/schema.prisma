generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  verifiedSlips     PaymentSlip[] @relation("VerifiedBy")
  checkedInReservs  Reservation[] @relation("CheckedInBy")
  souvenirReservs   Reservation[] @relation("SouvenirBy")
  merchVerifiedSlips MerchPaymentSlip[] @relation("MerchVerifiedBy")
}

model Alumni {
  id                String   @id @default(cuid())
  fullName          String
  graduationYear    String?
  department        String?
  currentOccupation String?
  phone             String?
  email             String?
  lineId            String?
  photoUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([phone])
}

enum EventStatus {
  draft
  open
  closed
}

model Event {
  id            String      @id @default(cuid())
  name          String
  eventDate     DateTime
  location      String?
  seatsPerTable Int         @default(10)
  pricePerTable Decimal     @db.Decimal(10, 2)
  pricePerSeat  Decimal     @db.Decimal(10, 2)
  status        EventStatus @default(draft)
  floorPlanUrl  String?
  createdAt     DateTime    @default(now())

  tables       Table[]
  reservations Reservation[]
}

model Table {
  id                 String   @id @default(cuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableNumber        Int
  capacity           Int
  seatsReserved      Int      @default(0)
  isFullTableBooking Boolean  @default(false)
  zone               String?
  zoneColor          String?
  positionX          Float?
  positionY          Float?

  reservations Reservation[]

  @@unique([eventId, tableNumber])
  @@index([eventId])
}

enum BookingType {
  full_table
  seats
}

enum PaymentStatus {
  pending
  awaiting_verify
  confirmed
  rejected
  expired
}

model Reservation {
  id             String        @id @default(cuid())
  bookingCode    String        @unique
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId        String
  table          Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  bookingType    BookingType
  seatCount      Int
  bookerName     String
  bookerPhone    String
  bookerEmail    String?
  partyNames     Json?
  paymentStatus  PaymentStatus @default(pending)
  totalAmount    Decimal       @db.Decimal(10, 2)
  reservedUntil  DateTime
  checkedIn      Boolean       @default(false)
  checkedInAt    DateTime?
  checkedInBy    String?
  checkedInByUser AdminUser?   @relation("CheckedInBy", fields: [checkedInBy], references: [id])
  souvenirGiven   Boolean      @default(false)
  souvenirGivenAt DateTime?
  souvenirGivenBy String?
  souvenirGivenByUser AdminUser? @relation("SouvenirBy", fields: [souvenirGivenBy], references: [id])
  qrCodeToken    String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  slips PaymentSlip[]

  @@index([eventId])
  @@index([tableId])
  @@index([bookerPhone])
  @@index([paymentStatus, reservedUntil])
}

model PaymentSlip {
  id            String       @id @default(cuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fileKey       String
  uploadedAt    DateTime     @default(now())
  verifiedBy    String?
  verifiedByUser AdminUser?  @relation("VerifiedBy", fields: [verifiedBy], references: [id])
  verifiedAt    DateTime?
  note          String?

  @@index([reservationId])
}

// --- Merchandise ordering (สั่งซื้อของที่ระลึก) ---
// Fully independent of table booking — anyone can order without booking a
// table. Reuses the same PaymentStatus enum and slip-upload-then-admin-
// approves flow as Reservation/PaymentSlip above.

model MerchProduct {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  imageKey     String?
  requiresSize Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  orderItems MerchOrderItem[]
  stocks     MerchProductStock[]
}

// One row per (product, size) — size is null for products that don't
// require a size (requiresSize: false), so each such product has exactly
// one stock row. Sized products (e.g. shirts) get one row per size.
model MerchProductStock {
  id        String       @id @default(cuid())
  productId String
  product   MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  quantity  Int          @default(0)

  @@unique([productId, size])
  @@index([productId])
}

model MerchOrder {
  id            String        @id @default(cuid())
  orderCode     String        @unique
  bookerName    String
  bookerPhone   String
  bookerEmail   String?
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items MerchOrderItem[]
  slips MerchPaymentSlip[]

  @@index([bookerPhone])
  @@index([paymentStatus])
}

model MerchOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     MerchOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // productId/product is now optional: deleting a product must not be
  // blocked by its order history. productName is a snapshot taken at order
  // time (same idea as unitPrice below) so past orders keep showing a real
  // name even after the product is gone.
  productId String?
  product   MerchProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  size      String?
  quantity  Int
  unitPrice Decimal       @db.Decimal(10, 2)

  @@index([orderId])
}

model MerchPaymentSlip {
  id             String     @id @default(cuid())
  orderId        String
  order          MerchOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileKey        String
  uploadedAt     DateTime   @default(now())
  verifiedBy     String?
  verifiedByUser AdminUser? @relation("MerchVerifiedBy", fields: [verifiedBy], references: [id])
  verifiedAt     DateTime?
  note           String?

  @@index([orderId])
}
