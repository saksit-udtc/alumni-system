generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  CHECKIN_STAFF
  MERCH_STAFF
  FINANCE_STAFF
  RESERVATION_STAFF
}

// Small generic key-value store for app-wide settings that don't warrant
// their own dedicated table/columns — e.g. the merch shipping fee. One row
// per setting, value stored as text and parsed by the reader (see
// lib/settings.ts).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         AdminRole @default(SUPER_ADMIN)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  verifiedSlips     PaymentSlip[] @relation("VerifiedBy")
  checkedInReservs  Reservation[] @relation("CheckedInBy")
  souvenirReservs   Reservation[] @relation("SouvenirBy")
  merchVerifiedSlips MerchPaymentSlip[] @relation("MerchVerifiedBy")
  auditLogs         AuditLog[]
  posSales          PosSale[] @relation("PosCashier")
  posPackageSales   Reservation[] @relation("PosPackageCashier")
}

// Two kinds of entries, told apart by actorType:
//  - "ADMIN": an admin performed an action on a record (adminId/action/targetType/targetId set, path null).
//  - "PUBLIC": an anonymous visit to a public page was recorded (path set, everything else null).
// No IP address or other visitor-identifying data is stored for PUBLIC entries by design.
model EmailLog {
  id        String   @id @default(cuid())
  type      String
  recipient String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([recipient])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  detail     String?
  path       String?
  createdAt  DateTime @default(now())

  @@index([actorType, createdAt])
  @@index([adminId])
  @@index([targetType, targetId])
}

model Alumni {
  id                String   @id @default(cuid())
  fullName          String
  graduationYear    String?
  department        String?
  currentOccupation String?
  phone             String?
  email             String?
  lineId            String?
  photoUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([phone])
}

enum EventStatus {
  draft
  open
  closed
}

model Event {
  id            String      @id @default(cuid())
  name          String
  eventDate     DateTime
  location      String?
  seatsPerTable Int         @default(10)
  pricePerTable Decimal     @db.Decimal(10, 2)
  pricePerSeat  Decimal     @db.Decimal(10, 2)
  status        EventStatus @default(draft)
  floorPlanUrl  String?
  createdAt     DateTime    @default(now())

  tables       Table[]
  reservations Reservation[]
  packages     Package[]
}

model Table {
  id                 String   @id @default(cuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableNumber        Int
  capacity           Int
  seatsReserved      Int      @default(0)
  isFullTableBooking Boolean  @default(false)
  zone               String?
  zoneColor          String?
  positionX          Float?
  positionY          Float?

  reservations Reservation[]

  @@unique([eventId, tableNumber])
  @@index([eventId])
}

enum BookingType {
  full_table
  seats
}

enum PaymentStatus {
  pending
  awaiting_verify
  confirmed
  rejected
  expired
}

model Reservation {
  id             String        @id @default(cuid())
  bookingCode    String        @unique
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId        String
  table          Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  bookingType    BookingType
  seatCount      Int
  bookerName     String
  bookerPhone    String
  bookerEmail    String?
  partyNames     Json?
  paymentStatus  PaymentStatus @default(pending)
  totalAmount    Decimal       @db.Decimal(10, 2)
  reservedUntil  DateTime
  checkedIn      Boolean       @default(false)
  checkedInAt    DateTime?
  checkedInBy    String?
  checkedInByUser AdminUser?   @relation("CheckedInBy", fields: [checkedInBy], references: [id])
  souvenirGiven   Boolean      @default(false)
  souvenirGivenAt DateTime?
  souvenirGivenBy String?
  souvenirGivenByUser AdminUser? @relation("SouvenirBy", fields: [souvenirGivenBy], references: [id])
  qrCodeToken    String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // --- Package booking (ขายแบบแพ็กเกจ: จองโต๊ะ+แถมสินค้า) ---
  // Set only when this reservation was created from a pre-configured
  // Package (see the Package model below) rather than a plain table
  // booking. packageItems is the snapshot of the merch items that came
  // bundled with the package at the moment of purchase (same snapshot
  // pattern as MerchOrderItem/PosSaleItem — a later edit to the Package's
  // item list must never retroactively change a past sale's record).
  packageId      String?
  package        Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageItems   ReservationPackageItem[]
  // Set only for a package reservation sold at the in-person POS counter
  // (immediate cash/transfer payment, confirmed on the spot — see
  // lib/bookPackage.ts's immediateConfirm path). Both stay null for a
  // normal online booking, which keeps using slip-upload + paymentStatus
  // instead.
  paymentMethod  PosPaymentMethod?
  cashierId      String?
  cashierUser    AdminUser?    @relation("PosPackageCashier", fields: [cashierId], references: [id])

  slips PaymentSlip[]

  @@index([eventId])
  @@index([tableId])
  @@index([bookerPhone])
  @@index([paymentStatus, reservedUntil])
  @@index([packageId])
}

model PaymentSlip {
  id            String       @id @default(cuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fileKey       String
  uploadedAt    DateTime     @default(now())
  verifiedBy    String?
  verifiedByUser AdminUser?  @relation("VerifiedBy", fields: [verifiedBy], references: [id])
  verifiedAt    DateTime?
  note          String?

  // --- EasySlip auto-verification (see lib/easyslip.ts) ---
  // Filled in fire-and-forget right after upload, fully independent of the
  // admin's own verifiedBy/verifiedAt above — this is an automated second
  // opinion the admin sees as a badge next to "ดูสลิป", never a gate on
  // approval. easyslipStatus is one of "MATCH" | "AMOUNT_MISMATCH" |
  // "INVALID_SLIP" | "DUPLICATE" | "ERROR" | "SKIPPED" (see SlipVerifyStatus
  // in lib/easyslip.ts); null until the check has run at least once.
  easyslipStatus    String?
  easyslipMessage   String?
  easyslipTransRef  String?
  easyslipCheckedAt DateTime?

  @@index([reservationId])
}

// --- Merchandise ordering (สั่งซื้อของที่ระลึก) ---
// Fully independent of table booking — anyone can order without booking a
// table. Reuses the same PaymentStatus enum and slip-upload-then-admin-
// approves flow as Reservation/PaymentSlip above.

// Homepage promotional slide banners (schedule, guest artists, merch ads,
// etc.) — admin-managed so staff can add/remove/reorder without a code
// change. Public homepage shows only active=true rows, ordered by sortOrder.
model HomeBanner {
  id        String   @id @default(cuid())
  imageKey  String
  title     String?
  linkUrl   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model LandingGalleryImage {
  id        String   @id @default(cuid())
  imageKey  String
  caption   String?
  category  String   @default("ทั่วไป")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model MerchProduct {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  // Cover image (shown first / used by POS + admin thumbnails). Extra
  // gallery photos live in MerchProductImage below.
  imageKey     String?
  // Optional back-side photo (e.g. back of a shirt). When set, the shop's
  // product detail view shows a ด้านหน้า/ด้านหลัง toggle (imageKey = front)
  // instead of the extra-photo gallery.
  backImageKey String?
  // Optional size-chart image (e.g. shirt measurements) shown on the shop's
  // product detail view — uploaded by admin, null for products without one.
  sizeGuideKey String?
  requiresSize Boolean  @default(false)
  active       Boolean  @default(true)
  // ลำดับแสดงในหน้าร้าน (น้อย = ขึ้นก่อน) — ตรงกับคอลัมน์ในมิเกรชัน 20260919120000
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  orderItems   MerchOrderItem[]
  images       MerchProductImage[]
  stocks       MerchProductStock[]
  posSaleItems PosSaleItem[]
  packageItems PackageItem[]
  reservationPackageItems ReservationPackageItem[]
}

// Additional gallery photos for a product, shown after the cover image
// (MerchProduct.imageKey) on the shop's product detail view, in sortOrder.
model MerchProductImage {
  id        String       @id @default(cuid())
  productId String
  product   MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageKey  String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([productId, sortOrder])
}

// One row per (product, size) — size is null for products that don't
// require a size (requiresSize: false), so each such product has exactly
// one stock row. Sized products (e.g. shirts) get one row per size.
model MerchProductStock {
  id        String       @id @default(cuid())
  productId String
  product   MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  quantity  Int          @default(0)
  // System-generated barcode printed on a sticker label for this exact
  // (product, size) variant — scanned at the POS counter to add it to a
  // sale. Null until an admin generates one from the product page (see
  // lib/barcode.ts's ensureStockBarcode). Unique so a POS scan resolves to
  // exactly one stock row.
  barcode   String?      @unique

  @@unique([productId, size])
  @@index([productId])
}

model MerchOrder {
  id              String        @id @default(cuid())
  orderCode       String        @unique
  bookerName      String
  bookerPhone     String
  bookerEmail     String
  shippingAddress String        @db.Text
  // Snapshot of the shipping fee in effect at order time (same idea as
  // MerchOrderItem.unitPrice below) — a later change to the configured fee
  // in AppSetting must never retroactively change a past order's total.
  shippingFee     Decimal       @default(50) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(pending)
  // Shipment tracking — filled in by staff once the parcel is handed to the
  // carrier. trackingNumber == null means "not shipped yet".
  carrier             String    @default("EMS")
  trackingNumber      String?
  shippedAt           DateTime?
  shipmentEmailSentAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items MerchOrderItem[]
  slips MerchPaymentSlip[]

  // Set only when this order was created from a merch-only Package
  // (bookingType null — "เฉพาะของที่ระลึก", online-only, see
  // lib/createMerchPackageOrder.ts) — null for every plain product-cart
  // order (the original, untouched path via lib/createMerchOrder.ts).
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([bookerPhone])
  @@index([paymentStatus])
  @@index([packageId])
}

model MerchOrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     MerchOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // productId/product is now optional: deleting a product must not be
  // blocked by its order history. productName is a snapshot taken at order
  // time (same idea as unitPrice below) so past orders keep showing a real
  // name even after the product is gone.
  productId String?
  product   MerchProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  size      String?
  quantity  Int
  unitPrice Decimal       @db.Decimal(10, 2)

  @@index([orderId])
}

model MerchPaymentSlip {
  id             String     @id @default(cuid())
  orderId        String
  order          MerchOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileKey        String
  uploadedAt     DateTime   @default(now())
  verifiedBy     String?
  verifiedByUser AdminUser? @relation("MerchVerifiedBy", fields: [verifiedBy], references: [id])
  verifiedAt     DateTime?
  note           String?

  // --- EasySlip auto-verification — mirrors PaymentSlip above exactly. ---
  easyslipStatus    String?
  easyslipMessage   String?
  easyslipTransRef  String?
  easyslipCheckedAt DateTime?

  @@index([orderId])
}

// --- Point of sale (ขายหน้างานด้วยการสแกนบาร์โค้ด) ---
// A completely separate, in-person counterpart to MerchOrder above: a
// staff member scans each item's printed barcode (see MerchProductStock.
// barcode), takes payment on the spot (cash or bank transfer), and the
// sale is recorded as confirmed immediately — there is no slip upload or
// admin-verification wait, because payment is already settled at the
// counter before this record is created (see lib/posSale.ts).
enum PosPaymentMethod {
  cash
  transfer
}

model PosSale {
  id            String           @id @default(cuid())
  saleCode      String           @unique
  cashierId     String
  cashier       AdminUser        @relation("PosCashier", fields: [cashierId], references: [id])
  paymentMethod PosPaymentMethod
  totalAmount   Decimal          @db.Decimal(10, 2)
  // Optional — a POS sale is normally a quick anonymous walk-up sale;
  // unlike MerchOrder these are never required.
  buyerName     String?
  buyerPhone    String?
  createdAt     DateTime         @default(now())

  // Set only when this sale was created from a merch-only Package
  // (bookingType null) via lib/packageMerchSale.ts — null for every plain
  // barcode-scan POS sale (the original, still-untouched path).
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  items PosSaleItem[]

  @@index([cashierId])
  @@index([createdAt])
  @@index([packageId])
}

model PosSaleItem {
  id        String       @id @default(cuid())
  saleId    String
  sale      PosSale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // productId/product optional so deleting a product later never blocks
  // this sale's history — productName/unitPrice are snapshots taken at
  // sale time, same pattern as MerchOrderItem above.
  productId String?
  product   MerchProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  size      String?
  // Null for a row that came from a merch-only Package sale (see PosSale.
  // packageId above) — those items were never individually scanned, they
  // were bundled by the admin ahead of time. Always set for a normal
  // barcode-scan sale, unchanged from before.
  barcode   String?
  quantity  Int
  unitPrice Decimal      @db.Decimal(10, 2)

  @@index([saleId])
}

// --- Packages (ขายแบบแพ็กเกจ: จองโต๊ะ + แถมสินค้า) ---
// A Package is an admin-configured fixed bundle: one table booking (same
// full_table/seats shape as a plain Reservation) plus a fixed list of merch
// items included for one bundle price. Sellable both at the POS counter
// (Phase 1, immediate confirm) and — later — through the public online
// booking flow (Phase 2, same pending/awaiting_verify slip flow as a plain
// Reservation). Buying a package still produces exactly one Reservation
// row (with packageId set) plus one ReservationPackageItem per bundled
// item — see lib/bookPackage.ts.
model Package {
  id          String      @id @default(cuid())
  name        String
  description String?
  eventId     String
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // null = a merch-only package ("เฉพาะของที่ระลึก" — no table involved at
  // all, sold only at the POS counter via lib/packageMerchSale.ts, never
  // through the public online booking flow). Non-null keeps the original
  // table+merch bundle behavior (lib/bookPackage.ts).
  bookingType BookingType?
  // Seats consumed on the chosen table — for bookingType "full_table" this
  // must equal the table's capacity (validated at booking time, same rule
  // as plain bookTable()); for "seats" it's the number of seats reserved.
  // null for a merch-only package (no table, so no seat count).
  seatCount   Int?
  // Fixed bundle price (replaces the table's normal pricePerTable/
  // pricePerSeat*seatCount calculation entirely for a package purchase).
  price       Decimal     @db.Decimal(10, 2)
  // Cover image shown on the merch shop's package card and the package's
  // own purchase page — same convention as MerchProduct.imageKey (uploaded
  // via POST /api/admin/packages/[id]/image into the shared
  // merch-products bucket, under a "packages/" key prefix). null shows the
  // same "no image" placeholder the product grid uses.
  imageKey    String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items        PackageItem[]
  reservations Reservation[]
  // Legacy/unused: an earlier iteration sold merch-only packages via POS
  // (PosSale.packageId) before this was changed to online-only — the
  // relation stays (some test data may reference it) but nothing writes
  // to it going forward.
  posSales     PosSale[]
  // Online orders of a merch-only package (bookingType null — see
  // lib/createMerchPackageOrder.ts). A table+merch package purchase never
  // touches this; it always goes through reservations above.
  merchOrders  MerchOrder[]

  @@index([eventId])
}

// One row per merch item bundled into a Package (e.g. "เสื้อที่ระลึก, size L,
// x1"). Live config, not a snapshot — edited directly as the admin changes
// the package's contents. No onDelete override on productId: a product
// still referenced by a package's item list can't be deleted until the
// admin removes it from the package first (same "don't silently corrupt an
// active bundle" reasoning as PackageItem being config rather than history).
model PackageItem {
  id        String       @id @default(cuid())
  packageId String
  package   Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String
  product   MerchProduct @relation(fields: [productId], references: [id])
  // Fixed size chosen by the admin at config time — null when either the
  // product doesn't need a size, or buyerChoosesSize is true (in which case
  // this is always null and the actual size is recorded per-purchase on
  // ReservationPackageItem/PosSaleItem instead).
  size      String?
  // true = the admin deliberately leaves size open ("ระบุไซส์เอง") and the
  // buyer picks a size (from the product's real stock rows) at purchase
  // time — POS counter or the online package form. false (default) keeps
  // the original behavior: size is fixed by the admin above.
  buyerChoosesSize Boolean @default(false)
  quantity  Int          @default(1)

  @@index([packageId])
  @@index([productId])
}

// Snapshot of one bundled item as it existed at the moment a Package was
// actually purchased (mirrors MerchOrderItem/PosSaleItem) — created inside
// bookPackage()'s transaction alongside the Reservation, one row per
// PackageItem on the Package that was bought. productId/product optional
// so deleting a product later never blocks this reservation's history.
model ReservationPackageItem {
  id            String        @id @default(cuid())
  reservationId String
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  productId     String?
  product       MerchProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  size          String?
  quantity      Int

  @@index([reservationId])
}

enum SupportRegistrationType {
  distinguished_alumni
  sponsor
}

// ลงทะเบียนศิษย์เก่าดีเด่น (ค่าลงทะเบียนคงที่) และผู้สนับสนุนงาน (ผู้สนับสนุน
// กำหนดวงเงินเอง) — ใช้ตารางเดียวกัน แยกด้วย type ชำระผ่าน PromptPay QR แล้วแนบ
// สลิปในคำขอเดียวกัน (สถานะเริ่มต้น awaiting_verify) ให้แอดมินตรวจสอบภายหลัง
model SupportRegistration {
  id            String                  @id @default(cuid())
  code          String                  @unique
  type          SupportRegistrationType
  name          String
  // ศิษย์เก่า: รุ่น/ปีที่จบ + แผนก | ผู้สนับสนุน: ชื่อบริษัท/หน่วยงาน (ถ้ามี)
  detail        String?
  phone         String
  email         String
  amount        Decimal                 @db.Decimal(12, 2)
  paymentStatus PaymentStatus           @default(awaiting_verify)
  slipFileKey   String
  adminNote     String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  // --- EasySlip auto-verification (advisory only; admin still approves) —
  // same fields as PaymentSlip / MerchPaymentSlip. ---
  easyslipStatus    String?
  easyslipMessage   String?
  easyslipTransRef  String?
  easyslipCheckedAt DateTime?

  @@index([type, paymentStatus])
  @@index([createdAt])
}
